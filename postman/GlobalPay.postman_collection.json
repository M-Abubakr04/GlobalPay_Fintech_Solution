{
  "info": {
    "name": "GlobalPay FinTech Solutions",
    "_postman_id": "a7b13a96-451f-4ee5-8e0d-globalpay2026",
    "description": "API demonstration collection for the five connected GlobalPay modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Platform",
      "item": [
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ready', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('access_token', body.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "customer@globalpay.example.com"
                },
                {
                  "key": "password",
                  "value": "Customer123!"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Module 1 - Wallet",
      "item": [
        {
          "name": "My Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/customers/me"
          }
        },
        {
          "name": "My Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wallet returned', () => pm.response.to.have.status(200));",
                  "pm.environment.set('sender_wallet_id', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/wallets/me"
          }
        },
        {
          "name": "Wallet Activity",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/wallets/me/activity"
          }
        }
      ]
    },
    {
      "name": "Module 2 - Payments",
      "item": [
        {
          "name": "Wallet Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_email\": \"receiver@globalpay.example.com\",\n  \"amount\": \"2500.00\",\n  \"description\": \"Postman demonstration transfer\",\n  \"new_device\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/payments/transfer"
          }
        },
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/payments/history"
          }
        }
      ]
    },
    {
      "name": "Module 4 - Open Banking",
      "item": [
        {
          "name": "Create Consent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set('consent_id', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"Postman Demo App\",\n  \"scopes\": [\n    \"accounts:read\",\n    \"payments:write\"\n  ],\n  \"expires_in_hours\": 24\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/open-banking/consents"
          }
        },
        {
          "name": "AIS Account Information",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/open-banking/ais/accounts/{{sender_wallet_id}}?consent_id={{consent_id}}"
          }
        },
        {
          "name": "Create CBDC Wallet",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_label\": \"Postman ePKR Wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/cbdc/wallets"
          }
        }
      ]
    }
  ]
}